{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "ir-dev@infrared": true,
    "ir-org@infrared": true,
    "ir-sdk@infrared": true,
    "ir-research@infrared": true,
    "infrared@infrared-skills": true
  },
  "extraKnownMarketplaces": {
    "infrared": {
      "source": {
        "source": "github",
        "repo": "Infrared-city/ir-team-skills"
      }
    },
    "infrared-skills": {
      "source": {
        "source": "github",
        "repo": "Infrared-city/infrared-skills"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(uv:*)",
      "Bash(pytest:*)",
      "Bash(make:*)",
      "Bash(./scripts/run_qgis_tests.sh:*)",
      "Bash(ruff:*)",
      "Bash(flake8:*)",
      "Bash(pylint:*)",
      "Bash(bandit:*)",
      "Bash(pb_tool:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow view:*)"
    ]
  }
}
